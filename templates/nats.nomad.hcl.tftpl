job "${job_name}" {
  namespace   = "${namespace}"
  datacenters = ${jsonencode(datacenters)}
  type        = "service"

  meta {
    secret_version = "${secret_version}"
    backup         = "stop"
  }

  group "nats" {
    network {
      mode = "bridge"

      port "client" {
        static       = ${client_port}
        to           = 4222
        host_network = "${internal_network}"
      }

      port "monitor" {
        static       = ${monitor_port}
        to           = 8222
        host_network = "${internal_network}"
      }
%{ if mesh.enabled ~}

      # Envoy's metrics, scraped by the platform's Alloy for Consul's topology.
      port "envoy_metrics" {
        to           = 9102
        host_network = "${internal_network}"
      }
%{ endif ~}
    }

    volume "data" {
      type            = "host"
      source          = "${volume_name}"
      access_mode     = "single-node-writer"
      attachment_mode = "file-system"
    }

    service {
      name     = "${job_name}"
      port     = "client"
      provider = "consul"
%{ if mesh.enabled ~}

      # In the mesh: an Envoy sidecar takes the clients' traffic (transparent
      # proxy), so mesh services reach NATS as ${job_name}.virtual.consul, over
      # mTLS, as the intentions allow. The monitoring port (the health check), the
      # ports kept open and Envoy's metrics are still reached directly.
      connect {
        sidecar_service {
          # Its own tags: the sidecar takes the service's otherwise.
          tags = ["mesh-sidecar"]

          proxy {
            transparent_proxy {
              # Envoy runs as uid 1337, which no app uses: the transparent proxy
              # lets Envoy's own uid out unredirected.
              uid                   = "1337"
              no_dns                = true
              exclude_inbound_ports = ${jsonencode(concat([for p in mesh.keep_open_ports : tostring(p)], ["8222", "9102"]))}
            }
            config {
              envoy_prometheus_bind_addr = "0.0.0.0:9102"
            }
          }
        }

        sidecar_task {
          env {
            ENVOY_UID = "1337"
          }

          resources {
            cpu        = 50
            memory     = 32
            memory_max = 128
          }
        }
      }
%{ endif ~}

      check {
        type     = "http"
        port     = "monitor"
        path     = "/healthz?js-enabled-only=true"
        interval = "10s"
        timeout  = "3s"
      }
    }
%{ if mesh.enabled ~}

    service {
      name     = "${job_name}-envoy"
      port     = "envoy_metrics"
      provider = "consul"
      tags     = ["metrics"]
    }
%{ endif ~}

    task "nats" {
      driver = "docker"

      config {
        image    = "${image}"
        args     = ["-c", "/local/nats.conf"]
        cap_drop = ["all"]
      }

      volume_mount {
        volume      = "data"
        destination = "/data"
      }

      vault {}

      template {
        destination = "secrets/nats.env"
        env         = true
        data        = <<-EOT
          {{ with secret "${secret_path}" }}
%{ for u in users ~}
          NATS_${upper(u)}_PASSWORD={{ .Data.data.${u} }}
%{ endfor ~}
          {{ end }}
        EOT
      }

      template {
        destination = "local/nats.conf"
        data        = <<-NATSCONF
${config}
        NATSCONF
      }

      resources {
        cpu        = ${resources.cpu}
        memory     = ${resources.memory}
        memory_max = ${resources.memory_max}
      }
    }
  }
}
